# OpenAI 兼容的 LLM 服务配置（按服务商提供的参数填写）
# 多模型配置：每项只填 MODEL、API_KEY、BASE_URL、NAME。
# MODEL 是服务商提供的模型名称；
# NAME 是自定义展示名称；
# API_KEY 只在后端使用；
# BASE_URL 是 OpenAI 兼容接口地址，通常以 /v1 结尾。
# 内部 ID 自动生成；数组第一项作为服务端默认模型。
# 同一个 BASE_URL + MODEL 组合只能出现一次，以保持内部 ID 稳定。
# LLM_MODELS 必须保持为合法 JSON；支持下面这种未加引号的多行数组。
LLM_MODELS=[
  {
    "MODEL": "deepseek-chat",
    "API_KEY": "your_deepseek_key",
    "BASE_URL": "https://api.deepseek.com/v1",
    "NAME": "DeepSeek"
  },
  {
    "MODEL": "gpt-4o-mini",
    "API_KEY": "your_openai_key",
    "BASE_URL": "https://api.openai.com/v1",
    "NAME": "OpenAI"
  }
]
# JWT 认证密钥
SECRET_KEY=change_me_to_a_random_secret_string

# 数据库连接
# MySQL: mysql+pymysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/socraticmind

# 允许的前端源（逗号分隔），生产环境改为实际域名
CORS_ORIGINS=http://localhost:5173

# 邮件服务
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
