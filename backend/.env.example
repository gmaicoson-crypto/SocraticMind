# OpenAI 兼容的 LLM 服务配置（按服务商提供的参数填写）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=your-model-id

# JWT 认证密钥
SECRET_KEY=change_me_to_a_random_secret_string

# 数据库连接
# MySQL: mysql+pymysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/socraticmind

# 允许的前端源（逗号分隔），生产环境改为实际域名
CORS_ORIGINS=http://localhost:5173

# 邮件服务
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
