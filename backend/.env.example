# OpenAI 兼容的 LLM 服务配置（按服务商提供的参数填写）
# 多模型配置：LLM_MODELS 是 JSON 数组，每个对象代表一个可选的模型服务。
# id：唯一标识，前端提交的模型选择值；name：前端显示名称；
# api_key：服务商密钥，只在后端使用，不会返回给前端；
# base_url：OpenAI 兼容接口地址，通常以 /v1 结尾；model：服务商实际模型 ID。
# LLM_MODELS 必须保持为合法 JSON；支持下面这种未加引号的多行数组。
LLM_MODELS=[
  {
    "id": "deepseek",
    "name": "DeepSeek",
    "api_key": "your_deepseek_key",
    "base_url": "https://api.deepseek.com/v1",
    "model": "deepseek-chat"
  },
  {
    "id": "openai",
    "name": "OpenAI",
    "api_key": "your_openai_key",
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-4o-mini"
  }
]
# 默认使用的 profile id，必须对应上面某个对象的 id；不填写时使用数组第一项。
LLM_DEFAULT_MODEL_ID=deepseek

# 兼容单模型配置：只有在 LLM_MODELS 为空或未配置时生效；配置多个模型时会被忽略。
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=your-model-id

# JWT 认证密钥
SECRET_KEY=change_me_to_a_random_secret_string

# 数据库连接
# MySQL: mysql+pymysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/socraticmind

# 允许的前端源（逗号分隔），生产环境改为实际域名
CORS_ORIGINS=http://localhost:5173

# 邮件服务
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
